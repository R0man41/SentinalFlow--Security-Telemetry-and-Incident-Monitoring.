# Optional local Express port. Defaults to 3001 if omitted.
PORT=3001

# Required for admin routes; set private values in your local .env or hosting secrets.
ADMIN_AUTH_USERNAME=
ADMIN_AUTH_PASSWORD=

# Public browser origin for admin write-request protection; set this in HTTPS deployment.
PUBLIC_ORIGIN=

# Required for machine-to-machine POST /events requests; keep the value private.
EVENT_INGESTION_TOKEN=

# POST /events rate limit: one process-local bucket; defaults to 120/minute and burst 30.
EVENT_RATE_LIMIT_PER_MINUTE=120
EVENT_RATE_LIMIT_BURST=30

# Optional exact browser origins, comma-separated; leave empty for same-origin only.
CORS_ALLOWED_ORIGINS=

# Optional incident JSON path; defaults to backend/incidents.json.
# For cloud deployment, use a writable persistent location. The parent directory
# must already exist. Relative paths are resolved from the process working directory.
INCIDENTS_FILE=

# In-memory normalized events retained for /events BF_001 correlation.
# Maximum is hard-capped at 10000; retention is bounded to 5 minutes–1 hour.
RECENT_EVENT_MAX_COUNT=1000
RECENT_EVENT_RETENTION_MS=600000

# Deterministic request-volume detection for /events (same client IP, event-time window).
# Values are clamped to 4–1000 requests and 1–240 seconds.
BEHAVIOR_REQUEST_THRESHOLD=20
BEHAVIOR_REQUEST_WINDOW_SECONDS=60
